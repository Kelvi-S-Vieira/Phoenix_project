# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Dashboard -> Project Settings -> API). Never commit the
# real .env.local — it's already in .gitignore.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key (Settings -> API -> Project API keys -> anon public)
# Safe to expose to the browser — Row Level Security is what actually
# protects the data, not keeping this secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings -> API -> Project API keys -> service_role).
# SECRET — only needed if a future server-only script/route needs to bypass
# Row Level Security (e.g. an admin task). Nothing in this sprint's code uses
# it yet. Never expose this in client code or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key — powers the Diário's AI features ("Foto (IA)" calorie
# estimation from a plate photo, and "Descrever (IA)" free-text meal
# parsing). Get one at https://console.anthropic.com/settings/keys. SECRET —
# server-only, used in app/api/diario/estimar/route.ts, never exposed to the
# browser. Without this set, those two Diário modes show a friendly "recurso
# de IA não configurado" message instead of crashing; every other feature in
# the app works fine without it.
ANTHROPIC_API_KEY=your-anthropic-api-key
